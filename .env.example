# Copy this file to `.env` and adjust as needed.
# ALL values below are placeholders. No real secrets belong in this repo.
#
# The service runs fully offline out of the box: LLM_PROVIDER=mock uses a
# deterministic, local, no-network MockLLM and FAISS as a local vector store.
# Nothing in this default configuration calls out to the internet.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
APP_NAME=compliance-copilot

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM provider selection ---
# "mock" (default, offline, deterministic) | "openai" | "anthropic"
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=openai. Leave blank to stay fully offline.
OPENAI_API_KEY=

# Only required if LLM_PROVIDER=anthropic. Leave blank to stay fully offline.
ANTHROPIC_API_KEY=

# --- Retrieval / RAG tuning ---
CORPUS_DIR=data/sample_policies
VECTOR_INDEX_DIR=.index/faiss
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
HYBRID_DENSE_WEIGHT=0.6
HYBRID_SPARSE_WEIGHT=0.4
SIMILARITY_REFUSAL_THRESHOLD=0.22

# --- Governance ---
AUDIT_LOG_PATH=.audit/audit.log.jsonl
ENABLE_PII_REDACTION=true

# --- Observability ---
OTEL_TRACING_ENABLED=true
