# Template only -- DO NOT commit a real filled-in Secret to version
# control. Copy this to `secret.yaml` (gitignored), fill in real values
# (or better, manage it via your cluster's external-secrets operator /
# sealed-secrets / cloud secret manager), and `kubectl apply -f` it
# separately from the rest of the manifests.
#
# Values must be base64-encoded, e.g.: echo -n "sk-..." | base64
apiVersion: v1
kind: Secret
metadata:
  name: compliance-copilot-secrets
  labels:
    app: compliance-copilot
type: Opaque
data:
  OPENAI_API_KEY: ""   # base64-encoded; leave empty to stay on MockLLM
  ANTHROPIC_API_KEY: "" # base64-encoded; leave empty to stay on MockLLM
